{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "${private_bucket_arn}",
      "Condition": { "StringLike": { "s3:prefix": ["security-scans/*"] } }
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "${private_bucket_arn}/security-scans/*"
    },
    {
      "Effect": "Allow",
      "Action": ["rds-db:connect"],
      "Resource": "${ops_dbuser_arn}/security_app"
    }
  ]
}
